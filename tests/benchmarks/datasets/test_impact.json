      "description": "Changes to authentication module should affect auth-related tests across the stack",
      "input": {
        "project_id": "proj_bench_impact",
        "commit_sha": "abc123def456",
        "branch": "feature/oauth-migration",
        "changed_files": [
          {"path": "src/auth.py", "change_type": "modified", "additions": 45, "deletions": 20, "diff_summary": "Replaced session-based auth with OAuth2 PKCE flow; added refresh token rotation"},
          {"path": "src/middleware/auth_middleware.py", "change_type": "modified", "additions": 15, "deletions": 8, "diff_summary": "Updated token validation to check OAuth2 bearer tokens instead of session cookies"},
          {"path": "src/models/user.py", "change_type": "modified", "additions": 5, "deletions": 2, "diff_summary": "Added oauth_provider and oauth_sub fields to User model"}
        ],
        "existing_tests": [
          {"id": "test_login_flow", "file": "tests/e2e/test_auth.py", "type": "e2e", "tags": ["auth", "login"]},
          {"id": "test_signup_flow", "file": "tests/e2e/test_auth.py", "type": "e2e", "tags": ["auth", "signup"]},
          {"id": "test_session_expiry", "file": "tests/e2e/test_auth.py", "type": "e2e", "tags": ["auth", "session"]},
          {"id": "test_protected_routes", "file": "tests/integration/test_middleware.py", "type": "integration", "tags": ["auth", "middleware"]},
          {"id": "test_user_crud", "file": "tests/integration/test_users.py", "type": "integration", "tags": ["users", "crud"]},
          {"id": "test_dashboard_load", "file": "tests/e2e/test_dashboard.py", "type": "e2e", "tags": ["dashboard"]},
          {"id": "test_api_products", "file": "tests/integration/test_products.py", "type": "integration", "tags": ["products", "api"]}
        ]
      },
      "ground_truth": {
        "affected_test_ids": ["test_login_flow", "test_signup_flow", "test_session_expiry", "test_protected_routes", "test_user_crud"],
        "unaffected_test_ids": ["test_api_products"],
        "risk_score_min": 0.7,
        "suggested_new_tests_must_mention": ["oauth", "token refresh", "bearer token"],
        "impact_category": "authentication"
      }
