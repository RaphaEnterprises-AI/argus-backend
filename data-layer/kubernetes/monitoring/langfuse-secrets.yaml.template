# Langfuse Secrets - Self-hosted LLM Observability
#
# IMPORTANT: Copy this to langfuse-secrets.yaml and replace placeholder values!
#
# Generate secrets with:
#   NEXTAUTH_SECRET=$(openssl rand -base64 32)
#   SALT=$(openssl rand -base64 32)
#   MINIO_ROOT_PASSWORD=$(openssl rand -base64 24)
#
# Apply with: kubectl apply -f langfuse-secrets.yaml
# =============================================================================
---
# PostgreSQL credentials (for Supabase)
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-postgres-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: langfuse
    app.kubernetes.io/part-of: argus
type: Opaque
stringData:
  username: "postgres"
  # Supabase database password - update if different
  password: "REPLACE_WITH_SUPABASE_PASSWORD"
---
# Redis/Valkey credentials (from existing Valkey)
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-redis-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: langfuse
    app.kubernetes.io/part-of: argus
type: Opaque
stringData:
  # Valkey password from argus-data namespace
  password: "REPLACE_WITH_VALKEY_PASSWORD"
---
# MinIO root credentials
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-minio-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: langfuse
    app.kubernetes.io/part-of: argus
type: Opaque
stringData:
  rootUser: "langfuse-admin"
  rootPassword: "REPLACE_WITH_MINIO_ROOT_PASSWORD"
---
# Authentication secrets
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-auth-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: langfuse
    app.kubernetes.io/part-of: argus
type: Opaque
stringData:
  nextauth-secret: "REPLACE_WITH_NEXTAUTH_SECRET"
  salt: "REPLACE_WITH_SALT"
  # Langfuse project secret key for Cognee worker
  langfuse-project-secret: "REPLACE_WITH_LANGFUSE_PROJECT_SECRET"
  # Admin password for Langfuse UI access
  admin-password: "REPLACE_WITH_ADMIN_PASSWORD"
---
# Cloudflare R2 credentials (S3-compatible blob storage)
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-r2-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: langfuse
    app.kubernetes.io/part-of: argus
type: Opaque
stringData:
  access-key-id: "REPLACE_WITH_R2_ACCESS_KEY_ID"
  secret-access-key: "REPLACE_WITH_R2_SECRET_ACCESS_KEY"
